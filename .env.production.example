# Production Environment Variables Template
# IMPORTANT: Copy this to .env on your GoDaddy server and fill in YOUR actual values
# NEVER commit the actual .env file to git!

# ============================================
# DATABASE (REQUIRED)
# ============================================
# For PostgreSQL on GoDaddy server:
DATABASE_URL="postgresql://exphouz_user:your-strong-password@localhost:5432/exphouz"

# For external database (AWS RDS, DigitalOcean, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/exphouz"


# ============================================
# NEXT.JS & AUTHENTICATION (REQUIRED)
# ============================================
# Your production domain - MUST be HTTPS in production
NEXTAUTH_URL="https://yourdomain.com"

# Generate a random secret using: openssl rand -base64 32
# OR from: https://generate-secret.vercel.app/
NEXTAUTH_SECRET="your-generated-random-secret-here"


# ============================================
# GOOGLE OAUTH (REQUIRED)
# ============================================
# Get from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Web Application credentials
# 4. Add https://yourdomain.com to authorized redirect URIs

GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"


# ============================================
# LINKEDIN OAUTH (OPTIONAL)
# ============================================
# Get from: https://www.linkedin.com/developers/apps
# Only needed if you want LinkedIn login feature

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"


# ============================================
# EMAIL CONFIGURATION - SMTP (REQUIRED)
# ============================================
# Using Gmail (recommended):
# 1. Enable 2-Factor Authentication on Gmail
# 2. Generate "App Password": https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below (not your regular password)

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM_EMAIL="Exphouz <no-reply@exphouz.com>"

# Alternative email providers:
# SendGrid: SMTP_HOST="smtp.sendgrid.net", SMTP_PORT="587"
# AWS SES: SMTP_HOST="email-smtp.region.amazonaws.com", SMTP_PORT="587"
# Brevo: SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT="587"


# ============================================
# IMAGEKIT CONFIGURATION (REQUIRED)
# ============================================
# Get from: https://imagekit.io
# 1. Sign up for free account
# 2. Log in to your ImageKit dashboard
# 3. Click your avatar (top-right) → Select "Settings"
# 4. In left sidebar, click "API Keys"
# 5. Copy the three values:
#    - Public Key (starts with "public_")
#    - Private Key (starts with "private_")
#    - URL Endpoint (https://ik.imagekit.io/your-id)
# Direct link: https://imagekit.io/dashboard/developer/api-keys

NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_account_id"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxx"


# ============================================
# NOTES
# ============================================
# - NEXT_PUBLIC_* variables are exposed to browser (use for public keys only)
# - Private keys (IMAGEKIT_PRIVATE_KEY, GOOGLE_CLIENT_SECRET, etc.) are server-only
# - Never share secrets in git commits or with others
# - Rotate secrets regularly in production
# - Use strong passwords for all services
